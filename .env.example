# Copy to .env and fill in. Real environment variables override .env.
# Keep comments on their own lines: "KEY=   # comment" would make the
# comment text the value when the value is empty.

# --- Server ---
PORT=8080
# Gemini's inline audio limit is ~20MB per request
MAX_UPLOAD_MB=20
# Time budget for one AI analysis (upload and delivery have their own limits)
ANALYZE_TIMEOUT_SECONDS=90

# --- Security / load protection ---
# If set, /v1/* requires "Authorization: Bearer <key>" or "X-API-Key: <key>".
# Leave empty for local development.
API_KEY=
# Requests per minute per client IP
RATE_LIMIT_PER_MINUTE=10
# Concurrent analyses; extra requests get 503 + Retry-After
MAX_CONCURRENT_JOBS=4
# Comma-separated IPs/CIDRs of your load balancer, so rate limiting sees real
# client IPs via X-Forwarded-For. Leave empty when clients connect directly.
TRUSTED_PROXIES=

# Gin runs in release mode unless set, e.g. GIN_MODE=debug for route logs
# GIN_MODE=debug

# --- Gemini (https://aistudio.google.com/apikey) ---
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash-lite

# --- Connectors: comma-separated, delivered in parallel ---
# Available: console, hubspot, notion, sheets, webhook. "none" analyses without
# delivering or storing anything (use it for public demos).
SINKS=console

# hubspot: Development -> Keys -> Service keys -> Create
# Scopes: crm.objects.contacts.read, crm.objects.contacts.write
HUBSPOT_TOKEN=
# Optional: adds a deep link to the contact (the number in your HubSpot URL)
HUBSPOT_PORTAL_ID=
# Optional, for EU data-center accounts:
# HUBSPOT_APP_URL=https://app-eu1.hubspot.com

# notion: Notion -> Developer tools -> Developer connections -> New connection
# -> "API token". Then open the target page -> ... -> Connections -> add it.
# Each note becomes a sub-page of that page.
NOTION_TOKEN=
# Page ID or the page URL copied from Notion
NOTION_PARENT_PAGE_ID=

# sheets: one row per note. No secret: uses Google Application Default
# Credentials. Locally run once:
#   gcloud auth application-default login --scopes=https://www.googleapis.com/auth/spreadsheets,https://www.googleapis.com/auth/cloud-platform
# then share the spreadsheet with your Google account (or, on Cloud Run, with
# the service account the deploy script prints) as Editor.
# Spreadsheet ID or URL
SHEETS_SPREADSHEET_ID=
# Optional tab name; default is the first tab
SHEETS_TAB=

# webhook: POSTs a signed JSON event to any URL (Zapier, Make, n8n, ...)
WEBHOOK_URL=
# Optional: HMAC-SHA256 signature in X-Signature-256
WEBHOOK_SECRET=

# Optional API base URLs for all connectors, e.g. for a proxy or a local fake
# HUBSPOT_BASE_URL=https://api.hubapi.com
# NOTION_BASE_URL=https://api.notion.com
